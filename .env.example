# ============================================
# CipherPoint Backend — Environment Example
# ============================================
# Copy this file to `.env` and fill in real values.
# DO NOT commit `.env` to version control (see .gitignore).
# ============================================

# --- App Environment ---
ENV=development
SECRET_KEY=replace-with-64-byte-random-string
HOST=0.0.0.0
PORT=8000
FRONTEND_URL=http://localhost:3000

# --- Database (Turso libSQL) ---
# Get from: https://turso.tech/  (or use local SQLite by leaving these blank)
TURSO_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-turso-jwt-token

# --- Telegram Bots ---
# Comma-separated list of upload bot tokens
TELEGRAM_BOT_TOKENS=123456:AAxxxxxxxxxxxx,789012:BBxxxxxxxxxxxx
TELEGRAM_ADMIN_BOT_TOKEN=admin-bot-token-here
REPORT_BOT_TOKEN=report-bot-token-here
TELEGRAM_CHANNEL_ID=-100xxxxxxxxxx
TELEGRAM_ADMIN_CHAT_ID=123456789

# --- Cloudflare Turnstile (optional) ---
CLOUDFLARE_SECRET_KEY=0x4XXXXXXXXXXXXXXXXX
TURNSTILE_ENABLED=false

# --- Community CTF Quota / Expiry ---
COMMUNITY_CTF_WEEKLY_LIMIT=2
COMMUNITY_CTF_EXPIRY_DAYS=7
EXPIRY_CHECK_INTERVAL=3600

# --- Upload Concurrency ---
UPLOAD_SEMAPHORE=20
BOT_FAILURE_THRESHOLD=5
BOT_CIRCUIT_OPEN_SECONDS=60

# --- CORS (comma-separated) ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:8000
