# ============================================
# CipherPoint .gitignore
# ============================================

# --- Python ---
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
.tox/

# --- Virtual environments ---
venv/
.venv/
env/
ENV/
backend/venv/
backend/.venv/
backend/env/

# --- Environment files with secrets ---
.env
.env.local
.env.development
.env.production
.env.staging
*.env.local
*.env.*.local
!.env.example

# --- Databases (local SQLite only) ---
*.db
*.sqlite
*.sqlite3
backend/cipherpoint.db
cipherpoint.db
data/

# --- Logs ---
*.log
logs/
*.pid

# --- Build artifacts ---
dist/
build/
*.whl
*.egg
*.spec

# --- IDE / OS ---
.DS_Store
.DS_Store?
._*
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*.swn
*~

# --- Node / Frontend (if any tooling added later) ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock
pnpm-lock.yaml
.cache/
.parcel-cache/

# --- Test artifacts ---
.cache/
.pytest_cache/
coverage/
.nyc_output/

# --- Render / Deploy ---
.render-r/
render-deploy-key.pem
.render-buildpacks/
*.deploy

# --- Uploaded media (user content; not in repo) ---
uploads/
media/
telegram_cache/

# --- Sensitive / Generated files ---
prompt.txt
*.bak
*.tmp
*.orig

# --- Frontend local (keep frontend/ source, ignore local overrides) ---
frontend/.htaccess
frontend/secrets.js
